{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed local check manifest; not an execution permission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "kind", "argv", "cwd", "env_allowlist", "timeout_seconds", "tracked_source_paths", "fixture_paths", "check_paths", "lockfile_paths", "variant_id", "seed", "warmups", "repeats", "oracle_description", "result_artifact", "metric_definitions", "test_authored_by", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["correctness", "benchmark", "build", "integration"]},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cwd": {"type": "string", "minLength": 1},
    "env_allowlist": {"$ref": "#/$defs/paths"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
    "tracked_source_paths": {"$ref": "#/$defs/paths"},
    "fixture_paths": {"$ref": "#/$defs/paths"},
    "check_paths": {"$ref": "#/$defs/paths"},
    "lockfile_paths": {"$ref": "#/$defs/paths"},
    "variant_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "warmups": {"type": "integer", "minimum": 0, "maximum": 3},
    "repeats": {"type": "integer", "minimum": 1, "maximum": 10},
    "oracle_description": {"type": "string", "minLength": 1},
    "result_artifact": {"type": "string", "minLength": 1},
    "test_authored_by": {"enum": ["candidate", "codex", "upstream", "mixed"]},
    "limitations": {"$ref": "#/$defs/paths"},
    "metric_definitions": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "unit", "direction", "measurement_scope", "aggregation"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "direction": {"enum": ["lower", "higher"]},
        "measurement_scope": {"type": "string", "minLength": 1},
        "aggregation": {"type": "string", "minLength": 1}
      }
    }}
  },
  "$defs": {"paths": {"type": "array", "items": {"type": "string", "minLength": 1}}}
}
